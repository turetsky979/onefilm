#!/bin/sh /etc/rc.common
# OpenWrt / iStoreOS procd init script for ONEFILM.
# Install: cp init.d/onefilm /etc/init.d/onefilm && chmod +x /etc/init.d/onefilm
# Then edit APP_DIR below (default /opt/onefilm) and run:
#   /etc/init.d/onefilm enable && /etc/init.d/onefilm start

START=99
STOP=10
USE_PROCD=1

APP_DIR="/opt/onefilm"
PYTHON_BIN="/usr/bin/python3"

start_service() {
  procd_open_instance
  procd_set_param command "$PYTHON_BIN" "$APP_DIR/movie_panel.py"
  procd_set_param env ONEFILM_CONF "$APP_DIR/config.json" \
                   ONEFILM_COOKIE "$APP_DIR/baidu_cookie.txt" \
                   ONEFILM_DATA_DIR "$APP_DIR/data" \
                   ONEFILM_INDEX "$APP_DIR/web/index.html"
  procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
